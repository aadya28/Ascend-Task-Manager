# ============================================
# ASCEND MySQL Container Configuration
# ============================================
# This file stores all your MySQL container settings
# You never have to remember these again!

# Container Settings
CONTAINER_NAME=ascend_mysql
MYSQL_IMAGE=mysql:8.0

# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=Task_Manager
MYSQL_USER=ascend_user
MYSQL_PASSWORD=ascend_password

# Port Configuration
MYSQL_PORT=3306

# Python Virtual Environment
VENV_PATH=venv
